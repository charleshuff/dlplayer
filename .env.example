# Copy to .env and uncomment what you want to change.

# Address and port on the host. Use BIND=127.0.0.1 behind a reverse proxy.
#BIND=0.0.0.0
#PORT=3000

# Set this to require a login (any username, this password).
#PASSWORD=

# Quality picked when the viewer has not chosen one: 144 ... 2160
#DEFAULT_QUALITY=1080

# How long a video stays on disk after the last time anyone played it.
# Closing the page does not delete it; this is what does. 0 keeps videos
# until the limits below need the room.
#UNPLAYED_DAYS=3

# Limits: videos on disk at once, and free space that must always remain.
# Once either is reached, the video played longest ago makes way.
#MAX_VIDEOS=10
#MIN_FREE_GB=2

# An Apple TV or other device running VLC, to send a video to from the player.
# Switch Remote Playback on in VLC first; leave this empty to hide the button.
#VLC_HOST=10.0.0.134

# yt-dlp: "nightly" (recommended, YouTube fixes land there first) or "stable",
# and how often to check for a new version.
#YTDLP_CHANNEL=nightly
#UPDATE_HOURS=3

# SponsorBlock categories to skip, in the browser and in what is sent to VLC.
# Leave the value empty to turn it off.
# Others: intro,outro,preview,music_offtopic,filler
#SPONSORBLOCK_CATEGORIES=sponsor,selfpromo,interaction
